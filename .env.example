# ==============================================================================
# AMAN GUPT PORTFOLIO - ENVIRONMENT VARIABLES CONFIGURATION (.env)
# ==============================================================================
#
# Choose ONE of the email providers below to power the contact form:
#
# ------------------------------------------------------------------------------
# OPTION 1: Resend (Recommended & Zero Configuration for Vercel)
# ------------------------------------------------------------------------------
# 1. Sign up for free at https://resend.com
# 2. Generate an API Key (starts with re_)
# 3. Add to your Vercel Project Settings > Environment Variables:
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# OPTION 2: SMTP / Nodemailer (e.g., Gmail App Password, SendGrid, Brevo)
# ------------------------------------------------------------------------------
# If using Gmail:
# 1. Enable 2-Step Verification in Google Account.
# 2. Create an App Password at: https://myaccount.google.com/apppasswords
# 3. Fill in the fields below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=amangupt7373@gmail.com
SMTP_PASS=

# ------------------------------------------------------------------------------
# OPTION 3: EmailJS Server-Side REST API
# ------------------------------------------------------------------------------
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Recipient email address
CONTACT_RECEIVER_EMAIL=amangupt7373@gmail.com
